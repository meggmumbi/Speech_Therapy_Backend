# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Environment / secrets
.env
.env.*
!.env.example

# Trained model artifacts (regenerated at runtime)
*.pkl
*.joblib
# ...except the fitted MD layer. It is 0.5 MB, deterministic to retrain
# (scripts/train_md_layer.py), and every verdict threshold assumes it is
# present. A checkout without it silently scores with raw GOP -- which is what
# happened to the 2026-09-15 pilot on a second machine.
!data/md_layer.joblib

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE
.idea/
.vscode/*
!.vscode/settings.json

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Logs
*.log

study_audio/

# research console
console/node_modules/
console/dist/
